
# Mac's LAN IP — reachable from iOS simulator, Android emulator, and physical devices on the same network
EXPO_PUBLIC_API_URL=http://<your-local-ip>:3000/api
# EXPO_PUBLIC_API_URL=https://<your-deployed-url>/api

EXPO_PUBLIC_USER_ID=1

# Laravel backend (service provider auth & profile)
EXPO_PUBLIC_LARAVEL_API_URL=https://uatservices-backend.theconvenientapp.store/api/v1
