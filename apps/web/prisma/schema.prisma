// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  individual
  business
}

enum ProfileTypeStatus {
  active
  pending
}

enum ServiceStatus {
  active
  inactive
  pendingReview @map("pending-review")
}

enum ServiceType {
  inPerson @map("in-person")
  remote
}

enum ServiceMode {
  freelance
  business
}

enum RateUnit {
  booking
  hour
}

enum RadiusUnit {
  mile
  km
}

enum FieldType {
  text
  number
  boolean
  select
  multiSelect
  url
  date
  textarea
}

model User {
  id                 Int               @id @default(autoincrement())
  email              String?           @unique
  firstName          String?
  lastName           String?
  password           String?
  phoneNumber        String?
  addresses          UserAddress[]
  accountType        AccountType
  profileTypeStatus  ProfileTypeStatus @default(active)
  isPersonVerified   Boolean           @default(false)
  isBusinessVerified Boolean           @default(false)
  avatarUrl          String?
  aboutMe            String?

  ownedBusiness        Business?             @relation("BusinessOwner")
  businessAffiliations BusinessAffiliation[]
  services             Service[]

  availabilityEnabled      Boolean                   @default(true)
  weeklyAvailabilitySlots  WeeklyAvailabilitySlot[]
  availabilityOverrideDays AvailabilityOverrideDay[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model Business {
  id          Int     @id @default(autoincrement())
  name        String
  registerDoc String?
  ownerIdDoc  String?
  ein         String?

  ownerId      Int                   @unique
  owner        User                  @relation("BusinessOwner", fields: [ownerId], references: [id])
  addresses    BusinessAddress[]
  affiliations BusinessAffiliation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model BusinessAffiliation {
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  user       User     @relation(fields: [userId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  services Service[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, businessId])
}

model Address {
  id        Int     @id @default(autoincrement())
  address   String
  latitude  String?
  longitude String?

  users      UserAddress[]
  businesses BusinessAddress[]
  services   Service[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model UserAddress {
  userId    Int
  addressId Int
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])
  address   Address @relation(fields: [addressId], references: [id])

  @@id([userId, addressId])
}

model BusinessAddress {
  businessId Int
  addressId  Int
  business   Business @relation(fields: [businessId], references: [id])
  address    Address  @relation(fields: [addressId], references: [id])

  @@id([businessId, addressId])
}

model Category {
  id            Int                  @id @default(autoincrement())
  name          String
  subcategories Subcategory[]
  customFields  ServiceCustomField[]
}

model Subcategory {
  id             Int                        @id @default(autoincrement())
  name           String
  category       Category                   @relation(fields: [categoryId], references: [id])
  categoryId     Int
  services       Service[]
  customFields   ServiceCustomField[]
  addonTemplates SubcategoryAddonTemplate[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

// SERVICES — common fields every service shares

model Service {
  id             Int                    @id @default(autoincrement())
  user           User                   @relation(fields: [userId], references: [id])
  userId         Int
  subcategory    Subcategory?           @relation(fields: [subcategoryId], references: [id])
  subcategoryId  Int?
  address        Address                @relation(fields: [addressId], references: [id])
  addressId      Int
  images         ServiceImage[]
  certifications ServiceCertification[]
  addons         ServiceAddon[]
  customValues   ServiceCustomValue[]

  serviceMode           ServiceMode
  business              BusinessAffiliation? @relation(fields: [businessAffiliationId], references: [id])
  businessAffiliationId Int?
  title                 String               @unique
  status                ServiceStatus        @default(pendingReview)
  serviceType           ServiceType
  areaRadius            Decimal?             @db.Decimal(10, 2)
  unit                  RadiusUnit           @default(mile)
  description           String
  aboutYou              String
  slogan                String?              @db.VarChar(255)
  baseRate              Decimal              @db.Decimal(12, 2)
  baseRateUnit          RateUnit
  createdAt             DateTime             @default(now()) @db.Timestamp(6)
  updatedAt             DateTime             @default(now()) @db.Timestamp(6)
  deletedAt             DateTime?
  deletionReason        String?
}

model ServiceImage {
  id        Int      @id @default(autoincrement())
  serviceId Int
  url       String
  altText   String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceCertification {
  id        Int      @id @default(autoincrement())
  serviceId Int
  name      String
  url       String
  fileName  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId])
}

model ServiceAddon {
  id         Int      @id @default(autoincrement())
  serviceId  Int
  templateId Int
  price      Decimal  @db.Decimal(12, 2)
  rateUnit   RateUnit

  service  Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  template SubcategoryAddonTemplate @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([serviceId, templateId])
}

// Flexible custom fields scoped to a category or subcategory

model ServiceCustomField {
  id            Int       @id @default(autoincrement())
  categoryId    Int?
  subcategoryId Int?
  fieldName     String
  fieldLabel    String
  fieldType     FieldType
  isRequired    Boolean   @default(false)
  displayOrder  Int       @default(0)
  options       Json?

  category    Category?            @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?         @relation(fields: [subcategoryId], references: [id])
  values      ServiceCustomValue[]

  @@unique([categoryId, subcategoryId, fieldName])
}

// Store user's input
model ServiceCustomValue {
  id           Int      @id @default(autoincrement())
  serviceId    Int
  fieldId      Int
  valueText    String?  @db.Text
  valueNumber  Decimal? @db.Decimal(15, 4)
  valueBoolean Boolean?
  valueJson    Json? // used for multiSelect field types

  service Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  field   ServiceCustomField @relation(fields: [fieldId], references: [id])

  @@unique([serviceId, fieldId])
  @@index([fieldId, valueText])
}

// Addon templates defined at the subcategory level — pre-populate when creating a service
model SubcategoryAddonTemplate {
  id              Int         @id @default(autoincrement())
  subcategoryId   Int
  subcategory     Subcategory @relation(fields: [subcategoryId], references: [id])
  name            String
  description     String?
  defaultPrice    Decimal?    @db.Decimal(12, 2)
  defaultRateUnit RateUnit
  isRequired      Boolean     @default(false)
  displayOrder    Int         @default(0)

  serviceAddons ServiceAddon[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([subcategoryId, name])
}

model WeeklyAvailabilitySlot {
  id        Int    @id @default(autoincrement())
  userId    Int
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "HH:mm" 24-hour
  endTime   String // "HH:mm" 24-hour
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model AvailabilityOverrideDay {
  id          Int                        @id @default(autoincrement())
  userId      Int
  date        DateTime
  isAvailable Boolean                    @default(true)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots       AvailabilityOverrideSlot[]

  @@unique([userId, date])
}

model AvailabilityOverrideSlot {
  id            Int                     @id @default(autoincrement())
  overrideDayId Int
  startTime     DateTime
  endTime       DateTime
  overrideDay   AvailabilityOverrideDay @relation(fields: [overrideDayId], references: [id], onDelete: Cascade)

  @@index([overrideDayId])
}
