// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  individual
  business
}

enum ServiceStatus {
  active
  inactive
  pendingReview @map("pending-review")
}

enum ServiceType {
  inPerson @map("in-person")
  remote
}

enum ServiceMode {
  freelance
  business
}

enum RateUnit {
  booking
  hour
}

enum FieldType {
  text
  number
  boolean
  select
  multiSelect @map("multi_select")
  url
  date
  textarea
}

model User {
  id          Int         @id @default(autoincrement())
  email       String?     @unique
  firstName   String?
  lastName    String?
  password    String?
  phoneNumber String?
  address     Address[]
  accountType AccountType
  isVerified  Boolean     @default(false)
  avatarUrl   String?

  ownedBusiness        Business?             @relation("BusinessOwner")
  businessAffiliations BusinessAffiliation[]
  services             Service[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model Business {
  id      Int     @id @default(autoincrement())
  name    String
  address String?

  ownerId      Int                   @unique
  owner        User                  @relation("BusinessOwner", fields: [ownerId], references: [id])
  affiliations BusinessAffiliation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model BusinessAffiliation {
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  user       User     @relation(fields: [userId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  services Service[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, businessId])
}

model Address {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  address   String
  latitude  String
  longitude String
  isDefault Boolean   @default(false)
  services  Service[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model Category {
  id            Int                  @id @default(autoincrement())
  name          String
  subcategories Subcategory[]
  customFields  ServiceCustomField[]
}

model Subcategory {
  id           Int                  @id @default(autoincrement())
  name         String
  category     Category             @relation(fields: [categoryId], references: [id])
  categoryId   Int
  services     Service[]
  customFields ServiceCustomField[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

// SERVICES — common fields every service shares

model Service {
  id             Int                    @id @default(autoincrement())
  user           User                   @relation(fields: [userId], references: [id])
  userId         Int
  subcategory    Subcategory?           @relation(fields: [subcategoryId], references: [id])
  subcategoryId  Int?
  address        Address                @relation(fields: [addressId], references: [id])
  addressId      Int
  images         ServiceImage[]
  certifications ServiceCertification[]
  addons         ServiceAddon[]
  customValues   ServiceCustomValue[]

  serviceMode  ServiceMode
  business     BusinessAffiliation?     @relation(fields: [businessAffiliationId], references: [id])
  businessAffiliationId   Int?
  title        String        @unique
  status       ServiceStatus @default(pendingReview)
  serviceType  ServiceType
  areaRadius   Decimal?      @db.Decimal(10, 2)
  description  String
  aboutYou     String
  slogan       String?      @db.VarChar(255)
  baseRate     Decimal       @db.Decimal(12, 2)
  baseRateUnit RateUnit
  createdAt    DateTime      @default(now()) @db.Timestamp(6)
  updatedAt    DateTime      @default(now()) @db.Timestamp(6)
}

model ServiceImage {
  id        Int      @id @default(autoincrement())
  serviceId Int
  url       String
  altText   String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceCertification {
  id        Int      @id @default(autoincrement())
  serviceId Int
  url       String
  fileName  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId])
}

model ServiceAddon {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  rateUnit    RateUnit
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

// Flexible custom fields scoped to a category or subcategory

model ServiceCustomField {
  id            Int       @id @default(autoincrement())
  categoryId    Int?
  subcategoryId Int?
  fieldName     String
  fieldLabel    String
  fieldType     FieldType
  isRequired    Boolean   @default(false)
  displayOrder  Int       @default(0)
  options       Json?

  category    Category?            @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?         @relation(fields: [subcategoryId], references: [id])
  values      ServiceCustomValue[]

  @@unique([categoryId, subcategoryId, fieldName])
}

model ServiceCustomValue {
  id           Int      @id @default(autoincrement())
  serviceId    Int
  fieldId      Int
  valueText    String?  @db.Text
  valueNumber  Decimal? @db.Decimal(15, 4)
  valueBoolean Boolean?

  service Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  field   ServiceCustomField @relation(fields: [fieldId], references: [id])

  @@unique([serviceId, fieldId])
  @@index([fieldId, valueText])
}
